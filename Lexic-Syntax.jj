{
    < Eliminar : ("remove_instance_variable"|"undef_method"|"chomp"|"unset"|"delete") > 
}

TOKEN: //EJECUCION SIMULTANEA COMO LOS HILOS DE C#  
{
    < Ejecucion_Simultanea : ("parallel") > 
}

TOKEN :
{
    < Numero: (["0"-"9"])+ > 
}

TOKEN :
{
    < DosPuntos: (":")+ > 
}

TOKEN : 
{
    <IDENTIFICADOR: (["_", "a"-"z", "A"-"Z"]) (["_", "a"-"z", "A"-"Z", "0"-"9"])* >
}

TOKEN: 
{
    <Texto: "\"" (~["\""])* "\"">
}


//ESTRUCTURA SYNTAX//
//OPERACIONES EXISTENTES//

void DoWhile(): {} //OPERACION 1 EXISTENTE
{
    <Bucle> <LlaveIzquierda> BloqueInstrucciones() <LlaveDerecha> <Cuando> <ParIzquierdo> Condicional() <ParDerecho> <PuntoComa>
}

void CicloWhile(): {} //OPERACION 2 EXISTENTE
{
    <Cuando> <ParIzquierdo> Condicional() <ParDerecho> <LlaveIzquierda> BloqueInstrucciones() <LlaveDerecha> 
}

void ImprimirEnPantalla():{} //OPERACION 3 EXISTENTE
{
    <Escribir> <ParIzquierdo> ((<Texto>| <IDENTIFICADOR>)) ( <Encadenar> (<Texto>| <IDENTIFICADOR>) )* <ParDerecho> <PuntoComa> 
}

void AsignarValorID(): {} //OPERACION 4 EXISTENTE
{
    <OpAsignacion> ( <Numero> | <IDENTIFICADOR> ) ( <PuntoComa> | ( <OpAritmetico> ( <Numero> | <IDENTIFICADOR> ) <PuntoComa> ) )
}

void AsignarValorIDExt(): {}
{
     <OpAsignacion> ( <Numero> | <IDENTIFICADOR> ) ( <PuntoComa> | ( <OpAritmetico> ( <Numero> | <IDENTIFICADOR> ) <PuntoComa> ) )
}

void InicializarClase(): {} //OPERACION 5 EXISTENTE
{
    <IDENTIFICADOR> <OpAsignacion> <ClaseInicializar> <IDENTIFICADOR> <ParIzquierdo> <ParDerecho> <PuntoComa>
}

void AsignarValorID_InicializarClase_GuardarDato_EliminarID(): {}
{
    <IDENTIFICADOR> (AsignarValorID() | InicializarClase() | Guardar_Eliminar())
}

void ExpresionAritmticaGeneral(): {}
{
    (<IDENTIFICADOR> (<OpAritmetico> (<IDENTIFICADOR>|<Numero>))?) | (<Numero> <OpAritmetico> (<IDENTIFICADOR>|<Numero>))
}

void Condicion(): {} //OPERACION 6 EXISTENTE
{
    <Preguntar> <ParIzquierdo> Condicional() <ParDerecho> <LlaveIzquierda> BloqueInstrucciones() <LlaveDerecha> ((Consecuencias())?)
}

void Condicional():{} 
{
    (<IDENTIFICADOR> <OpRelacional> (<IDENTIFICADOR> | <Numero>))  | (<Numero> <OpRelacional> <IDENTIFICADOR>)
}

void Consecuencias(): {} 
{
   <Consecuencia> <LlaveIzquierda> BloqueInstrucciones() <LlaveDerecha>
}

void DeclararMetodo(): {} //OPERACION 7 EXISTENTE
{
    (<Alcance>)? <TipoDato> <IDENTIFICADOR> ParametrosDelMetodo() 
    <LlaveIzquierda> BloqueInstrucciones() <LlaveDerecha> 
}

void ParametrosDelMetodo(): {}
{
    <ParIzquierdo> ( <TipoDato> <IDENTIFICADOR> (<Coma> <TipoDato> <IDENTIFICADOR>)* )? <ParDerecho>
}

void DeclararClase_Metodo(): {}
{
    <Privacidad> (DeclararMetodo() | DefinirClase())
}

void DefinirClase(): {} //OPERACION 8 EXISTENTE
{
    <Clase> <IDENTIFICADOR> <LlaveIzquierda> BloqueInstrucciones()   <LlaveDerecha>
}

void Importacion(): {} //OPERACION 9 EXISTENTE
{
    <Importar> <IDENTIFICADOR> ( <Punto> <IDENTIFICADOR> )* <PuntoComa>
}

void LlamarMetodo(): {} //OPERACION 10 EXISTENTE
{
    <Llamar> <IDENTIFICADOR> ParametrosDelMetodo() <PuntoComa>
}

void DeclararMetodoInterno(): {}
{
    (<Alcance>)? <TipoDato> <IDENTIFICADOR> ParametrosDelMetodo() 
    <LlaveIzquierda> BloqueInstrucciones() <LlaveDerecha> 
}

void DeclararClaseInterna(): {}
{
    <Clase> <IDENTIFICADOR> <LlaveIzquierda> BloqueInstrucciones() <LlaveDerecha>
}

void Declarar_ClaseInterna_MetodoInterno(): {}
{
    <Privacidad> ( DeclararMetodoInterno()|DeclararClaseInterna())
}

void RetornarValor(): {}
{
    <Retroceder> (ExpresionAritmticaGeneral()) <PuntoComa>
}

void DeclararIdentificador(): {} //OPERACION 11 EXISTENTE int 
{
    <IDENTIFICADOR> (<OpAsignacion> ( <Numero> | <IDENTIFICADOR> ))? 
    (
        <Coma> <IDENTIFICADOR> (<OpAsignacion> ( <Numero> | <IDENTIFICADOR> ))?
    )* 
    <PuntoComa>
}

void DeclararIdentificador_Matriz(): {}
{
    <TipoDato> (DeclararIdentificador() | DeclararMatriz())
}

//OPERACIONES PROPIAS//

void DeclararMatriz(): {} // int[A|5] numeros; OPERACION PROPIA 1
{
    <ParCuaIzquierdo> (<Numero>|<IDENTIFICADOR>) <ParCuaDerecho> <IDENTIFICADOR> <PuntoComa>
}

void GuardarDato(): {} //Entrada.read; OPERACION PROPIA 2
{
    <Leer><PuntoComa>
}

void Guardar_Eliminar(): {}
{
    <Punto> (GuardarDato() | EliminarID())
}

void GuardarExt_EliminarExt(): {}
{
    <Punto> (GuardarDatoExt() | EliminarIDExt())
}

void GuardarDatoExt(): {}
{
    <Leer><PuntoComa>
}

void AsignarValorIDExt_GuardarDatoExt_EliminarIDExt(): {}
{
    <IDENTIFICADOR> (AsignarValorIDExt() | GuardarExt_EliminarExt())
}

void EliminarID(): {} //Variable.delete; OPERACION PROPIA 3
{
    <Eliminar><PuntoComa>
}

void EliminarIDExt(): {}
{
    <Eliminar><PuntoComa>
}

void ConvertirDato(): {} // convert(int):contador; OPERACION PROPIA 4
{
    <ConvertirTipoDato><ParIzquierdo><TipoDato><ParDerecho><DosPuntos><IDENTIFICADOR><PuntoComa> 
}

void ManejoDeExcepciones(): {} // catch: (ex = NombreExcepcion) { BloqueInstrucciones } OPERACION PROPIA 5 
{
    <AtraparExcepcion> <DosPuntos> <ParIzquierdo> <IDENTIFICADOR> <OpAsignacion> <Excepcion> <ParDerecho> <LlaveIzquierda> BloqueInstrucciones() <LlaveDerecha>  
}

void CondicionalPertenencia(): {} //  (in A == B): {int x = 5;} //OPERACION PROPIA 6 (TIPO PYTHON)
{
    <ParIzquierdo> <Pertenencia> <IDENTIFICADOR> <OpRelacional> <IDENTIFICADOR> <ParDerecho> <DosPuntos> 
    <LlaveIzquierda> BloqueInstrucciones() <LlaveDerecha>  
}

void Asignar_Random_a_ID(): {} // random( 10 ; 100 ) = ClaveSegura; //OPERACION PROPIA 7
{
    <Aleatorio> <ParIzquierdo> <Numero> <PuntoComa> <Numero> <ParDerecho> <OpAsignacion> <IDENTIFICADOR> <PuntoComa>
}

void DelimitarCodigoDelPrograma(): {} // PROGRAM: Programa_para_realizar_calculos_v1 OPERACION PROPIA 8
{
    <DelimitarCodigo> <DosPuntos> <IDENTIFICADOR>
}

void Interrumpir_Ejecucion_Del_Programa(): {} // die PROGRAM: Programa_para_realizar_calculos_v1 OPERACION PROPIA 9
{
    <DelimitarFinal> DelimitarCodigoDelPrograma() <PuntoComa>
}

void EjecucionParalela(): {} // parallel ( CalculosParteUno {BloqueInstrucciones}; CalculosParteDos {BloqueInstrucciones}) OPERACION PROPIA 10
{
    <Ejecucion_Simultanea> <ParIzquierdo> 
    <IDENTIFICADOR> <LlaveIzquierda> BloqueInstrucciones() <LlaveDerecha> 
    <PuntoComa>                           
    <IDENTIFICADOR> <LlaveIzquierda> BloqueInstrucciones() <LlaveDerecha> 
    <ParDerecho>
}

//INTRUCCIONES DENTRO DE ALGUNA OTRA ESTRUCTURA
void BloqueInstrucciones(): {}
{
    
    (   
        DeclararIdentificador_Matriz() 
    |   Condicion() //CONDICION YA INCLUYE LA POSIBLE CONSECUENCIA
    |   ImprimirEnPantalla()
    |   DoWhile()
    |   CicloWhile()
    |   RetornarValor()
    |   LlamarMetodo()
    |   AsignarValorID_InicializarClase_GuardarDato_EliminarID()
    |   Declarar_ClaseInterna_MetodoInterno()
    |   GuardarDato()
    |   ConvertirDato()
    |   ManejoDeExcepciones()
    |   CondicionalPertenencia()
    |   Asignar_Random_a_ID()
    |   Interrumpir_Ejecucion_Del_Programa()
    |   EjecucionParalela()
    )+ 
}

//TOTALIDAD DEL CODIGO A ANALIZARSE
void SyntaxAnalisis() : {}
{
    Encabezado()
    CuerpoCodigo()
}

//COSAS OPCIONALES SOLAMENTE AL INICIO DEL CODIGO
void Encabezado(): {}
{   
    ( DelimitarCodigoDelPrograma() ) ( Importacion() )*
}

//RESTO DEL CODIGO
void CuerpoCodigo(): {}
{
    //ESTRUCTURA GENERAL DEL CODIGO
    (   
        DeclararIdentificador_Matriz()
    |   Condicion()
    |   ImprimirEnPantalla()
    |   DoWhile()
    |   CicloWhile()
    |   LlamarMetodo()
    |   DeclararClase_Metodo() 
    |   AsignarValorIDExt_GuardarDatoExt_EliminarIDExt()
    |   ConvertirDato()
    |   ManejoDeExcepciones()
    |   CondicionalPertenencia()
    |   Asignar_Random_a_ID()
    |   Interrumpir_Ejecucion_Del_Programa()
    |   EjecucionParalela()
    )+
}