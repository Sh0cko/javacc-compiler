
options {
    STATIC = false;
    IGNORE_CASE = false;
    DEBUG_TOKEN_MANAGER = false;
}


PARSER_BEGIN(Lexico)


import java.util.*;
import javax.swing.*;
import java.io.File;
import java.io.FileNotFoundException;
import java.io.FileReader;
import javax.swing.filechooser.FileNameExtensionFilter;

//java -cp "DireccionDelJar" org.javacc.parser.Main "Nombre.jj

public class Lexico 
{

    //OBTENER ARCHIVO
    private static void getFile() 
    {
        JFileChooser search = new JFileChooser();
        FileNameExtensionFilter filter1 = new FileNameExtensionFilter("Archivos de texto", "txt");
        search.setFileFilter(filter1);

        int option = search.showOpenDialog(null);
        if (option == JFileChooser.APPROVE_OPTION) 
        {
            file = search.getSelectedFile();
        }
    }


    
    public static int contadorIdentificadores = 0;
    public static String identificadoresUnicos = "";
    private static File file;
    private static int contador = 0;

    // TABLA DE SIMBOLOS
    public static class MiHashMap 
    {
        public LinkedHashMap<String, String> hashMap;
        private HashSet<String> hashSet;

        public MiHashMap() 
        {
            hashMap = new LinkedHashMap<String, String>(); // Especificando tipo de clave y valor
            hashSet = new HashSet<String>(); // Especificando tipo de elementos
        }

        // Método para agregar un elemento sin repetición
        public void agregar(String tokenNombre, String valor) 
        {
            if (hashSet.add(valor)) // Si no está presente, se añade al HashSet
            { 
                hashMap.put(tokenNombre, valor);
                contador += 1; // contador de las ID
            }
        }

        // comprobación
        public boolean contieneValor(String valor) 
        {
            return hashSet.contains(valor);
        }
    }

    //PROCESAR IDENTIFICADORES Y SUS INDICES
    public static void procesarIdentificador(Token t) 
    {
        String identificadorBusqueda = ";" + t.image + "=";
        int index = identificadoresUnicos.indexOf(identificadorBusqueda);

        int indice;
        if (index == -1) // NUEVO IDENTIFICADOR
        { 
            indice = contadorIdentificadores++;
            identificadoresUnicos += identificadorBusqueda + indice + ";";
        } 
        else  // IDENTIFICADOR REPETIDO
        {
            int startIndex = index + identificadorBusqueda.length();
            int endIndex = identificadoresUnicos.indexOf(";", startIndex);
            indice = Integer.parseInt(identificadoresUnicos.substring(startIndex, endIndex));
        }

        // Asigna el índice al token y agrégalo a la lista de tokens
        t.specialToken = new Token();  // `specialToken` para guardar el índice
        t.specialToken.image = String.valueOf(indice);
        tokensList.add(t);
    }

    //Método para imprimir tokenID con su indice
    public static void ImprimirTokensId(String tipo, int indice) 
    {
        System.out.println(tipo + " -> " + indice + "\n");
    }

    //Método para imprimir tokens con su tipo y contenido
    public static void ImprimirTokens(String tipo, String imagen) 
    {
        System.out.println(tipo + " -> " + imagen + "\n");
    }

    static ArrayList<Token> tokensList = new ArrayList<Token>();

    //MAIN MAIN MAIN MAIN
    public static void main(String[] args) 
    {
        MiHashMap miHashMap = new MiHashMap();
        getFile();

        if (file == null) {
            System.out.println("Archivo inválido o no seleccionado");
            System.exit(-1);
        }


        try {
            // Análisis léxico y captura de tokens
            FileReader reader = new FileReader(file);
            LexicoTokenManager lexer = new LexicoTokenManager(new SimpleCharStream(reader));
            Token t;


            while ((t = lexer.getNextToken()).kind != LexicoTokenManager.EOF) {
                
                //GUARDADO DE TOKENS LEIDOS
                if (t.kind != LexicoConstants.IDENTIFICADOR) 
                {
                    tokensList.add(t);  // Captura el token en la lista
                }
                else
                {
                    procesarIdentificador(t);
                }
                // Opcional: si necesitas agregar ciertos tokens a la tabla de símbolos
                if (t.kind == LexicoConstants.IDENTIFICADOR) {
                    String clave = String.valueOf(contador);
                    miHashMap.agregar(clave, t.image);
                }
            }

            /*
            for (Token token : tokensList) 
            {
                String tipoToken = obtenerNombreToken(token.kind);
                if (token.kind == LexicoConstants.IDENTIFICADOR) {
                ImprimirTokensId(tipoToken, Integer.parseInt(token.specialToken.image));
                } 
                else 
                {
                    ImprimirTokens(tipoToken, token.image);
                }
            }
            */

            /* 
            Mostrar tabla de símbolos
            System.out.println("Tabla de símbolos:");
            for (Map.Entry<String, String> entry : miHashMap.hashMap.entrySet()) 
            {
                System.out.println(entry.getKey() + " -> " + entry.getValue());
            }
            */

            // INICIO ANALISIS SINTACTICO //
            reader.close(); // Cierra el flujo de lectura anterior
            reader = new FileReader(file); // Vuelve a abrir el archivo
            SimpleCharStream charStream = new SimpleCharStream(reader);
            LexicoTokenManager newLexer = new LexicoTokenManager(charStream);

            try 
            {
                Lexico parser = new Lexico(newLexer);

                parser.SyntaxAnalisis();

                // Verifica si aún quedan tokens sin consumir
                Token nextToken = newLexer.getNextToken();
                if (nextToken.kind != 0) // Si no es el token EOF 
                { 
                    throw new ParseException("Estructura del código incorrecta");
                }

                System.out.println("\u001B[32m\nLa declaración es sintácticamente correcta.\u001B[0m");
            
            } 
            catch (ParseException e) {
            System.err.println("\u001B[31mError sintáctico: " + e.getMessage() + "\u001B[0m");
            }
            // FINAL ANALISIS SINTACTICO //


        } catch (FileNotFoundException e) {
            System.err.println("Archivo no encontrado: " + e.getMessage());
        } catch (Exception e) {
            System.err.println("Error al procesar el archivo: " + e.getMessage());
        }
    }

    // Método auxiliar para convertir el número del token a su nombre.
    public static String obtenerNombreToken(int tipo) {
        switch (tipo) {
            case LexicoConstants.TipoDato:
                return "Tipo de Dato";
            case LexicoConstants.OpAritmetico:
                return "Operador Aritmético";
            case LexicoConstants.OpAsignacion:
                return "Operador de Asignación";
            case LexicoConstants.OpRelacional:
                return "Operador Relacional";
            case LexicoConstants.OpLogico:
                return "Operador Lógico";
            case LexicoConstants.Leer:
                return "Leer";
            case LexicoConstants.Preguntar:
                return "Preguntar";
            case LexicoConstants.Bucle:
                return "Bucle";
            case LexicoConstants.Consecuencia:
                return "Consecuencia";
            case LexicoConstants.Aleatorio:
                return "Aleatorio";
            case LexicoConstants.DefFuncion:
                return "Definir Función";
            case LexicoConstants.Retroceder:
                return "Retroceder";
            case LexicoConstants.Privacidad:
                return "Privacidad";
            case LexicoConstants.Clase:
                return "Clase";
            case LexicoConstants.ClaseInicializar:
                return "Inicializacion de Clase";
            case LexicoConstants.Importar:
                return "Importar";
            case LexicoConstants.ConvertirTipoDato:
                return "Convertir entre tipo de dato";
            case LexicoConstants.Pertenencia:
                return "Pertenencia";
            case LexicoConstants.AtraparExcepcion:
                return "AtraparExcepcion";
            case LexicoConstants.DelimitarCodigo:
                return "Delimitar Código";
            case LexicoConstants.Escribir:
                return "Escribir";
            case LexicoConstants.DelimitarFinal:
                return "Delimitar Final";
            case LexicoConstants.Excepcion:
                return "Excepcion";
            case LexicoConstants.Llamar:
                return "Llamar";
            case LexicoConstants.Cuando:
                return "Cuando";
            case LexicoConstants.DefinirModulo:
                return "Definir Módulo";
            case LexicoConstants.Encadenar:
                return "Encadenar";
            case LexicoConstants.Objeto:
                return "Objeto";
            case LexicoConstants.AutoReferencia:
                return "AutoReferencia";
            case LexicoConstants.InicializarObj:
                return "Inicializar Objeto";
            case LexicoConstants.Metodo:
                return "Método";
            case LexicoConstants.LlaveIzquierda:
                return "Llave Izquierda";
            case LexicoConstants.LlaveDerecha:
                return "Llave Derecha";
            case LexicoConstants.ParIzquierdo:
                return "Paréntesis Izquierdo";
            case LexicoConstants.ParDerecho:
                return "Paréntesis Derecho";
            case LexicoConstants.ParCuaIzquierdo:
                return "Corchete Izquierdo";
            case LexicoConstants.ParCuaDerecho:
                return "Corchete Derecho";
            case LexicoConstants.Punto:
                return "Punto";
            case LexicoConstants.Coma:
                return "Coma";
            case LexicoConstants.PuntoComa:
                return "Punto y Coma";
            case LexicoConstants.SalirBucle:
                return "Salir del Bucle";
            case LexicoConstants.Eliminar:
                return "Eliminar";
            case LexicoConstants.Ejecucion_Simultanea:
                return "Interrupción";
            case LexicoConstants.Numero:
                return "Número";
            case LexicoConstants.IDENTIFICADOR:
                return "IDENTIFICADOR";
            default:
                return "Token Desconocido";
        }
    }
}

PARSER_END(Lexico)

SKIP : 
{
  " "| "\t" | "\r" | "\n"
}


TOKEN : 
{
    < TipoDato : ("true"|"false"|"trace_var"|"nil"|"linspace"|"randn"|"rand"|"eye"|"ones"|"zeros"|"persistent"|"sort"|"undef"|"state"|"our"|"set"|"packed"|"absolute"|"file"|"record"|"COMPLEX"|"DOUBLE PRECISION"|"char"|"PARAMETER"|"DIMENSION"|"ALLOCATABLE"|"CHARACTER"|"float"|"abstract"|"asm"|"auto"|"sizeof"|"static_cast"|"nullptr"|"constexpr"|"override"|"virtual"|"double"|"null"|"undefined"|"NaN"|"array"|"string"|"int"|"putStrLn"|"void"|"list"|"dict"|"str"|"boolean"|"struct"|"mut"|"enum"|"const"|"type"|"data"|"var"|"enum"|"INTEGER"|"REAL"|"val"|"mutable")+ > 
}

TOKEN: 
{
    < OpAritmetico : ("div"|"+"|"-"|"/"|"*"|"**") > 
}

TOKEN:
{
    < OpAsignacion : ("="|"MOVE") > 
}
TOKEN:
{
    < OpRelacional : ("<"|">"|"<="|">="|"=="|"!=") > 
}

TOKEN:
{
    < OpLogico : ("explicit"|"not"|"xor"|"or"|"and"|"&"| "&&" | "||" | "|") > 
}

TOKEN:
{
    < Leer : ("attr_reader"|"readln"|"readline"|"FORMAT"|"ENTRY"|"ifstream"|"cin"|"scanf"|"read"|"INPUT"|"input"|"IO"|"self") > 
}

TOKEN:
{
    < Preguntar : ("switch"|"checked"|"guard"|"rethrows"|"willSet"|"module_eval"|"class_eval"|"defined?"|"rescue"|"size"|"length"|"grep"|"unless"|"elsif"|"of"|"LOGICAL"|"callable"|"isset"|"empty"|"if"|"match"|"unsafe"|"maybe"|"instanceof") > 
}

TOKEN:
{
    < Bucle : ("next"|"retry"|"redo"|"last"|"downto"|"to"|"repeat"|"CYCLE"|"foreach"|"for"|"PERFORM"|"DO"|"do"|"loop"|"CONTINUE") > 
}

TOKEN:
{
    < Consecuencia : ("else"|"didSet"|"mod"|"finally"|"THEN"|"ELSE") > 
}

TOKEN: //MODIFICADO ANTES Aleatorio
{
    < Aleatorio : ("random") > 
}

TOKEN:
{
    < DefFuncion : ("mutating"|"associatedtype"|"event"|"define_singleton_method"|"alias"|"reshape"|"map"|"my"|"EXTERNAL"|"insteadof"|"def"|"fn"|"func"|"function") > 
}

TOKEN:
{
   < Retroceder : ("some"|"return"|"RETURN") > 
}

TOKEN:
{
    < Privacidad : ("subscript"|"fileprivate"|"protected_send"|"private_send"|"protected_class_method"|"private_class_method"|"EQUIVALENCE"|"COMMON"|"global"|"private"|"friend"|"protected"|"public"|"defp") > 
|   < Alcance: "static">
}

TOKEN:
{
    < Clase : ("singleton_class"|"extends"|"class") > 
}

TOKEN:
{
   < ClaseInicializar : ("new"|"instanceVariableNames") > 
}
  
TOKEN:
{
   < Importar : ("prepend"|"package"|"implementation"|"goto"|"use"|"implements"|"import"|"impl") > 
}

TOKEN:
{
   < ConvertirTipoDato : ("parse"|"convertTo"|"convert") > 
}

TOKEN: //MODIFICADO, antes era PROCEDIMIENTO
{
    < Pertenencia : ("indirect"|"attr_accessor"|"extend"|"ensure"|"sub"|"MODULE PROCEDURE"|"trait"|"SUBROUTINE"|"in") > 
}

